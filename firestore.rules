rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 &&
        id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidProduct(data, productId) {
      return data.keys().hasAll(['id', 'name', 'category', 'price', 'stock', 'sku', 'images']) &&
        data.id == productId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.category is string && data.category.size() > 0 &&
        data.price is number && data.price >= 0 &&
        data.stock is int && data.stock >= 0 &&
        data.sku is string && data.sku.size() <= 50 &&
        data.images is list;
    }

    function isValidCategory(data, categoryId) {
      return data.keys().hasAll(['id', 'slug', 'name', 'description', 'image', 'itemCount']) &&
        data.id == categoryId && data.slug is string &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
        data.description is string && data.image is string &&
        data.itemCount is int && data.itemCount >= 0;
    }

    function isValidPromo(data, promoCode) {
      return data.keys().hasAll(['code', 'description', 'isActive']) &&
        data.code == promoCode &&
        data.description is string && data.description.size() <= 500 &&
        data.isActive is bool &&
        (!('discountPercent' in data) ||
          (data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 100)) &&
        (!('discountAmount' in data) ||
          (data.discountAmount is number && data.discountAmount >= 0)) &&
        (!('minOrderAmount' in data) ||
          (data.minOrderAmount is number && data.minOrderAmount >= 0)) &&
        (('discountPercent' in data) || ('discountAmount' in data));
    }

    function isValidUser(data, userId) {
      return data.keys().hasAll(['email', 'displayName', 'uid', 'savedAddresses']) &&
        data.uid == userId &&
        data.email is string && data.email.size() <= 254 &&
        data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
        data.savedAddresses is list;
    }

    function isValidReview(data, reviewId) {
      return data.keys().hasAll([
          'id', 'productId', 'authorName', 'city', 'rating', 'date', 'comment',
          'verifiedPurchase', 'userId'
        ]) &&
        data.id == reviewId &&
        data.productId is string && data.productId.size() > 0 &&
        data.authorName is string && data.authorName.size() > 0 && data.authorName.size() <= 100 &&
        data.city is string && data.city.size() <= 100 &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        data.date is string && data.comment is string && data.comment.size() <= 2000 &&
        data.verifiedPurchase == false &&
        data.userId == request.auth.uid &&
        isValidId(reviewId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidId(productId) && isValidProduct(request.resource.data, productId);
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidId(categoryId) && isValidCategory(request.resource.data, categoryId);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /promos/{promoCode} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        isValidId(promoCode) && isValidPromo(request.resource.data, promoCode);
      allow delete: if isAdmin() && isValidId(promoCode);
    }

    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAdmin() && isValidId(orderId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'timeline', 'isPaid']) &&
        request.resource.data.status in [
          'en_attente', 'en_preparation', 'en_livraison', 'livree', 'annulee'
        ] &&
        request.resource.data.timeline is list &&
        request.resource.data.isPaid is bool;
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidReview(request.resource.data, reviewId);
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comment']) &&
          request.resource.data.comment is string &&
          request.resource.data.comment.size() <= 2000);
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) &&
        (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && isValidId(userId) &&
        request.auth.uid == userId && isValidUser(request.resource.data, userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer');
      allow update: if isSignedIn() && isValidId(userId) &&
        request.auth.uid == userId &&
        isValidUser(request.resource.data, userId) &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.email == resource.data.email &&
        (!('role' in resource.data) ||
          request.resource.data.role == resource.data.role) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'city', 'district', 'savedAddresses', 'wishlist'
        ]);
      allow delete: if false;
    }

    match /admins/{adminId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
