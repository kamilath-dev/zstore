# ZStore Bénin - Variables d'Environnement Exemple
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Admin backend login only; never expose these values to Vite/client code.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Firebase Web configuration is loaded from firebase-target-config.json.
# Firebase Admin uses Application Default Credentials and targets zstore-7ed88 / (default).
# Firebase Admin signs the short-lived HttpOnly session cookie; no local session key is needed.
# Do not place service-account keys in this file or the repository.
# GEMINI_API_KEY=
